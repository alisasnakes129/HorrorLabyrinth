<Window x:Class="HorrorLabyrinth.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Horror Labyrinth" Height="500" Width="850" Background="Black">
    <Grid>
        <!-- Фоновое изображение -->
        <Image x:Name="ImgRoom" Stretch="UniformToFill"/>

        <!-- Затемнение -->
        <Rectangle Fill="Black" Opacity="0.35"/>

        <!-- Спрайт игрока -->
        <Image x:Name="ImgPlayer" 
               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,0,0,120"
               Height="220" Stretch="Uniform" Visibility="Collapsed"/>

        <!-- Спрайт стража -->
        <Image x:Name="ImgCharacter" 
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,120"
               Height="240" Stretch="Uniform" Visibility="Collapsed"/>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Ввод имени -->
            <Border x:Name="NamePanel" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Background="#DD0B0B0B" BorderBrush="#FF330000" BorderThickness="1" Padding="30">
                <StackPanel Width="320">
                    <TextBlock Text="ПОГРУЖЕНИЕ В КОШМАР" Foreground="#FFCC0000" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="Введите имя главного героя:" Foreground="#DDDDDD" FontSize="14" Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtPlayerName" Height="32" FontSize="14" Background="#FF111111" Foreground="White" BorderBrush="#FF444444" Padding="5" Margin="0,0,0,15"/>
                    <Button Content="НАЧАТЬ ПУТЬ" Click="BtnStartGame_Click" Height="35" Background="#FF330000" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Панель диалогов -->
            <Border x:Name="GamePanel" Grid.Row="1" Background="#CC0A0A0A" BorderBrush="#FF222222" BorderThickness="1" Padding="15" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="TxtDialogue" Text="..." Foreground="#E0E0E0" FontSize="15" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,12"/>

                    <!-- Кнопка Далее -->
                    <Button x:Name="BtnNext" Content="Далее ➔" Click="BtnNext_Click" HorizontalAlignment="Right" Padding="15,6" Background="#FF222222" Foreground="White" BorderBrush="#FF444444"/>

                    <!-- Панель выборов на ЭТАПЕ 1 (Сразу после аварии) -->
                    <StackPanel x:Name="ChoicePanelStep1" Visibility="Collapsed" Margin="0,5,0,0">
                        <Button Content="1 — Прийти в себя и открыть глаза" Click="BtnChoiceOpenEyes_Click" Margin="0,0,0,6" Padding="10,6" HorizontalAlignment="Stretch" Background="#FF1A1A1A" Foreground="#FFEEEEEE" BorderBrush="#FF444444"/>
                        <Button Content="2 — Остаться ослабшим (не открывать глаза)" Click="BtnChoiceStayWeak_Click" Margin="0,0,0,6" Padding="10,6" HorizontalAlignment="Stretch" Background="#FF2A0A0A" Foreground="#FFFF5555" BorderBrush="#FF661111"/>
                    </StackPanel>

                    <!-- Панель выборов на ЭТАПЕ 2 (После исчезновения спутницы) -->
                    <StackPanel x:Name="ChoicePanelStep2" Visibility="Collapsed" Margin="0,5,0,0">
                        <Button Content="1 — Отправиться на поиски (идти к воротам замка)" Click="BtnChoiceSearchGirl_Click" Margin="0,0,0,6" Padding="10,6" HorizontalAlignment="Stretch" Background="#FF0A1A0A" Foreground="#FF55FF55" BorderBrush="#FF116611"/>
                        <Button Content="2 — Осмотреть разбитую машину" Click="BtnChoiceInspectCar_Click" Margin="0,0,0,6" Padding="10,6" HorizontalAlignment="Stretch" Background="#FF2A0A0A" Foreground="#FFFF5555" BorderBrush="#FF661111"/>
                        <Button Content="9 — Цель игры" Click="BtnChoiceGoal_Click" Padding="10,6" HorizontalAlignment="Stretch" Background="#FF111122" Foreground="#FF88AAFF" BorderBrush="#FF334466"/>
                    </StackPanel>

                    <!-- Панель выбора у ворот (Диалог со стражем) -->
                    <StackPanel x:Name="ChoicePanelGate" Visibility="Collapsed" Margin="0,5,0,0">
                        <Button Content="1 — Настоять на своем и идти дальше" Click="BtnGateInsist_Click" Margin="0,0,0,6" Padding="10,6" HorizontalAlignment="Stretch" Background="#FF0A1A0A" Foreground="#FF55FF55" BorderBrush="#FF116611"/>
                        <Button Content="2 — Сдаться как трус" Click="BtnGateCoward_Click" Margin="0,0,0,6" Padding="10,6" HorizontalAlignment="Stretch" Background="#FF2A0A0A" Foreground="#FFFF5555" BorderBrush="#FF661111"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>